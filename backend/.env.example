# Server Configuration
PORT=9086
HOST=0.0.0.0
CUSTOM_DOMAIN=https://your-custom-subdomain.com

# MongoDB Database URI (e.g. mongodb+srv://... from MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/local_stream

# Admin & Device Security
ADMIN_SECRET_KEY=change_this_to_your_secure_admin_passcode
DEVICE_JWT_SECRET=change_this_to_a_long_random_jwt_secret
JWT_STREAM_SECRET=change_this_to_another_long_random_jwt_secret

# Cloudinary Media Storage (from https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
