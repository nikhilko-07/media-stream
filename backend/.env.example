# Server Configuration
PORT=9086
HOST=0.0.0.0
CUSTOM_DOMAIN=https://stream.nikhilkohli.com

# MongoDB Database (Atlas Cloud Cluster)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/local_stream?retryWrites=true&w=majority

# Admin Email Verification & 24-Hour Token Security
VERIFY_MAIL=your_gmail_address@gmail.com
JWT_ADMIN_SECRET=your_admin_jwt_secret_key

# Admin & Device Security
ADMIN_SECRET_KEY=admin1234
DEVICE_JWT_SECRET=device_jwt_secret_key_1234
JWT_STREAM_SECRET=stream_jwt_secret_key_1234

# Cloudinary Media Storage (from https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
